# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Allowlist: sample data & results
# NOTE: must stay at the end of the file, after *.log/*.npy/etc. above (last match wins)

# data/: ignore everything except sample datasets
data/*
!data/README.md
!data/Surat
!data/W_Jinan

# All other dataset dirs: keep only stats.json
!data/*/
data/*/*
!data/*/stats.json

# Surat: ignore everything except the graph itself
!data/Surat/Surat.edges
!data/Surat/Surat.nodes

# W_Jinan: ignore everything except the following
!data/W_Jinan/W_Jinan.edges
!data/W_Jinan/W_Jinan.nodes
!data/W_Jinan/W_Jinan.parts.npz
!data/W_Jinan/landmark_dim61.embeddings.npz
!data/W_Jinan/node2vec_dim64_epochs1_unweighted_openne.embeddings.npz
!data/W_Jinan/real_workload_perturb_500k
!data/W_Jinan/real_workload

# results/: ignore everything except analysis
results/*
!results/README.md
